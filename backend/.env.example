# Variables de entorno del backend (configúralas en Render → Environment).
# NO pongas valores reales en este archivo ni en el código.

# Conexión a MongoDB
MONGO_URL=<cadena-de-conexion-mongodb>

# Contraseña inicial del panel admin. Solo se usa si la base de datos todavía
# no tiene una contraseña guardada; tras el primer login se guarda hasheada.
ADMIN_PASSWORD=<contraseña-larga-y-única>

# Secreto para firmar las sesiones del panel (genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))")
ADMIN_TOKEN_SECRET=<secreto-aleatorio-largo>
# Duración de la sesión admin en segundos (opcional, por defecto 8 h)
ADMIN_TOKEN_TTL_SECONDS=28800

# Clave que el bot envía en el header X-API-Key. Sin ella, /api/bot/* queda deshabilitado.
BOT_API_KEY=<clave-aleatoria-del-bot>

# Recuperación de contraseña por correo (sin esto, /admin/recover responde 503)
ADMIN_USERNAME=admin
ADMIN_EMAIL=<correo-del-admin>
SMTP_SERVER=<smtp.ejemplo.com>
SMTP_PORT=587
SMTP_USER=<usuario-smtp>
SMTP_PASSWORD=<contraseña-smtp>

# campid real de afiliado de Mercado Libre. Si se deja vacío, el marcador
# campid=TU_CAMPID_AQUI simplemente se elimina de los enlaces.
ML_AFFILIATE_CAMPID=

# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=https://capibaraml.com,https://www.capibaraml.com,http://localhost:3000

# API de Groq para el chatbot
GROQ_API_KEY=<clave-groq>
